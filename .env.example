# ─── Gemini Brain ───
GEMINI_API_KEY=your_gemini_api_key_here

# ─── GitHub ───
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_DEFAULT_OWNER=

# ─── Google Ecosystem (Unified OAuth — recommended for Gmail, Calendar, Docs) ───
# Download credentials.json from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ─── Fallback Gmail (IMAP/SMTP if not using Google OAuth) ───
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# ─── Calendar (Legacy read-only iCal fallback) ───
CALENDAR_ICAL_URL=

# ─── Notion ───
NOTION_API_KEY=secret_your_notion_integration_token_here
NOTION_DEFAULT_DATABASE_ID=

# ─── Browser Automation ───
PUPPETEER_HEADLESS=true

# ─── Webhook / API Hooks Server ───
HOOKS_PORT=8000

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

