# ─── Gemini Cloud Brain ───
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Hope Executive Web Application & Mobile PWA ───
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Base URL for webhook callbacks and ntfy action buttons (use your Tailscale IP or localhost)
WEB_BASE_URL=http://localhost:8080
# (Optional) Set a passphrase token for remote browser access:
WEB_AUTH_TOKEN=

# ─── Mobile Push Notifications (100% Free & Open Source via ntfy.sh) ───
# Install the free "ntfy" app on your iOS or Android phone, subscribe to a unique topic:
NTFY_TOPIC=my-secret-hope-alerts-unique123

# ─── Human Approval Gate & Safety ───
# Keep email draft-only to prevent accidental sends:
EMAIL_DRAFT_ONLY=true
# Require 1-click human approval in Web App before PR creations, file commits, email transmissions, and calendar deletions:
REQUIRE_APPROVAL=true

# ─── GitHub (Security: Use a Fine-Grained Token limited to specific repos) ───
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=github_pat_your_fine_grained_token_here
GITHUB_DEFAULT_OWNER=
# (Optional) Whitelist specific repos allowed for file writes and PR creations:
GITHUB_ALLOWED_REPOS=owner/repo1,owner/repo2

# ─── Google Ecosystem (Unified OAuth for Gmail, Calendar, Docs, Sheets) ───
# Download credentials.json from Google Cloud Console → APIs & Services → Credentials (Desktop app)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ─── Fallback Gmail (IMAP/SMTP if not using Google OAuth) ───
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# ─── Calendar (Legacy read-only iCal fallback) ───
CALENDAR_ICAL_URL=

# ─── Browser Automation (Puppeteer) ───
PUPPETEER_HEADLESS=true

# ─── Webhook / API Hooks Server (Localhost 127.0.0.1) ───
HOOKS_PORT=8000
# Secret used to verify GitHub HMAC-SHA256 signature (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_here
